<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Noor Alshater | Cybersecurity Portfolio</title>
  <link rel="stylesheet" href="style.css">
</head>
<body data-theme="dark">

  <!-- ===== Header / Navbar ===== -->
  <header class="navbar">
    <a class="brand" href="#home">Noor Alshater</a>

    <nav class="nav-links" id="navLinks">
      <a href="#home" data-i18n="nav.home">Home</a>
      <a href="#about" data-i18n="nav.about">About</a>
      <a href="#skills" data-i18n="nav.skills">Skills</a>
      <a href="#projects" data-i18n="nav.projects">Projects</a>
      <a href="#experience" data-i18n="nav.experience">Experience</a>
      <a href="#certificates" data-i18n="nav.certificates">Certificates</a>
      <a href="#hobbies" data-i18n="nav.hobbies">Hobbies</a>
      <a href="#contact" data-i18n="nav.contact">Contact</a>
    </nav>

    <div class="nav-buttons">
      <button id="themeBtn" type="button" data-i18n="ui.theme">Theme</button>
      <button id="langBtn" type="button">العربية</button>
      <button id="menuBtn" type="button">&#9776;</button>
    </div>
  </header>

  <main>

    <!-- ===== Home ===== -->
    <section id="home" class="hero">
      <p class="small-title" data-i18n="hero.eyebrow">Cybersecurity | Security Operations &amp; Penetration Testing</p>
      <h1 data-i18n="hero.title">Noor Eyad Alshater</h1>
      <p class="hero-text" data-i18n="hero.sub">Cybersecurity graduate building practical skills in network security, vulnerability scanning and security labs.</p>
      <div class="buttons">
        <a class="btn" href="#projects" data-i18n="hero.btnProjects">View Projects</a>
        <a class="btn outline" href="assets/Noor_Alshater_CV.pdf" download data-i18n="hero.btnCv">Download CV</a>
      </div>
    </section>

    <!-- ===== About Me ===== -->
    <section id="about">
      <h2 data-i18n="about.title">About Me</h2>
      <div class="about">
        <div class="photo-box">
          <img id="profilePhoto" src="assets/noor-formal.jpg" alt="Noor Alshater in a formal black blazer">
          <button id="photoBtn" type="button" data-i18n="about.switchPhoto">Switch photo</button>
        </div>
        <div class="about-text">
          <p data-i18n="about.p1">Cybersecurity graduate with practical learning experience through cybersecurity training, university projects and hands-on labs. I am especially interested in security operations, network security and learning how to investigate security events.</p>
          <p data-i18n="about.p2">I have practiced network scanning, traffic analysis and cybersecurity lab exercises. I also enjoy explaining technical ideas clearly and creating digital content as a side project.</p>
          <p><b data-i18n="about.eduK">Education:</b> <span data-i18n="about.eduV">B.Sc. Cybersecurity, Tafila Technical University (2022 - 2026)</span></p>
          <p><b data-i18n="about.gpaK">GPA:</b> <span>81.07 / 100</span></p>
          <p><b data-i18n="about.locK">Location:</b> <span data-i18n="about.locV">Amman, Jordan, open to relocation</span></p>
          <p><b data-i18n="about.langK">Languages:</b> <span data-i18n="about.langV">Arabic (native), English (B2)</span></p>
        </div>
      </div>
    </section>

    <!-- ===== Skills ===== -->
    <section id="skills">
      <h2 data-i18n="skills.title">Skills</h2>
      <div class="cards">
        <div class="card">
          <h3 data-i18n="skills.soc">Security Operations</h3>





          <p>SIEM Monitoring, Alert Triage, Log Analysis, Threat Hunting, Incident Investigation</p>
        </div>
        <div class="card">
          <h3 data-i18n="skills.pentest">Penetration Testing</h3>
          <p>Nmap, Metasploit, Burp Suite, Hydra, John the Ripper, Web Application Security</p>
        </div>
        <div class="card">
          <h3 data-i18n="skills.malware">Malware &amp; Forensics</h3>
          <p>Static and Dynamic Malware Analysis, FTK Imager, Autopsy, ExifTool, File Hashing</p>
        </div>
        <div class="card">
          <h3 data-i18n="skills.network">Network Security</h3>
          <p>Wireshark, Traffic Analysis, Network Scanning, Cisco Fundamentals</p>
        </div>
        <div class="card">
          <h3 data-i18n="skills.systems">Systems &amp; Scripting</h3>
          <p>Kali Linux, Windows, Linux CLI, VirtualBox, Bash, Python</p>
        </div>
        <div class="card">
          <h3 data-i18n="skills.risk">Risk &amp; Frameworks</h3>
          <p>Vulnerability Assessment, Risk Assessment, Security Reporting, MITRE ATT&amp;CK, Incident Response Fundamentals, GRC Fundamentals</p>
        </div>
      </div>
    </section>

    <!-- ===== Projects ===== -->
    <section id="projects">
      <h2 data-i18n="projects.title">Project Showcase</h2>
      <div class="cards">

        <div class="card">
          <h3>00 - <span data-i18n="p0.title">EduKernel Suite</span></h3>
          <p data-i18n="p0.desc">Graduation project: co-developed a multi-VM cybersecurity lab (Kali Linux, Windows 7, Windows 10) for penetration testing, malware analysis and digital forensics exercises.</p>
          <a class="link" href="https://github.com/Dalcots/EduKernel-Suite" target="_blank">GitHub</a>
        </div>

        <div class="card">
          <h3>01 - <span data-i18n="p1.title">Vulnerability Scanning</span></h3>
          <p data-i18n="p1.desc">Scanning a lab network and reviewing potential vulnerabilities using Nmap and Nessus.</p>
          <p class="muted" data-i18n="projects.request">Project details available on request</p>
        </div>

        <div class="card">
          <h3>02 - <span data-i18n="p2.title">Network Traffic Analysis</span></h3>
          <p data-i18n="p2.desc">Using Wireshark to inspect network packets and learn how common protocols communicate.</p>
          <p class="muted" data-i18n="projects.request">Project details available on request</p>
        </div>

        <div class="card">
          <h3>03 - <span data-i18n="p3.title">Web Development Exercises</span></h3>
          <p data-i18n="p3.desc">Small exercises to practice page structure, styling, responsive layouts and basic DOM events.</p>
          <a class="link" href="https://github.com/nooralshater/project01" target="_blank">Project 01</a>
          <a class="link" href="https://github.com/nooralshater/project02" target="_blank">Project 02</a>
        </div>

        <div class="card">
          <h3 data-i18n="p4.title">HTTP vs MQTT for IoT</h3>
          <p data-i18n="p4.desc">A research paper comparing HTTP and MQTT for IoT in latency, throughput, scalability and reliability.</p>
          <a class="link" href="assets/IoT_HTTP_vs_MQTT_Research_Paper.pdf" target="_blank" data-i18n="projects.view">View file</a>
        </div>

        <div class="card">
          <h3 data-i18n="p5.title">Linux Server Deployment &amp; Security</h3>
          <p data-i18n="p5.desc">Deployed Matomo on Ubuntu Server with Apache and MariaDB and applied basic security hardening.</p>
          <a class="link" href="assets/Linux_Matomo_Security_Project.pdf" target="_blank" data-i18n="projects.view">View file</a>
        </div>

        <div class="card">
          <h3 data-i18n="p6.title">Digital Forensics with Autopsy</h3>
          <p data-i18n="p6.desc">Created and verified a forensic disk image with FTK Imager, then used Autopsy to inspect files and metadata.</p>
          <a class="link" href="assets/Digital_Forensics_Autopsy_Project.pdf" target="_blank" data-i18n="projects.view">View file</a>
        </div>

        <div class="card">
          <h3 data-i18n="p7.title">Cybersecurity Data Analysis</h3>
          <p data-i18n="p7.desc">Explored cybersecurity indexes of countries using Python and Pandas.</p>
          <a class="link" href="assets/Cybersecurity_Data_Analysis_Report.docx" data-i18n="projects.view">View file</a>
        </div>

        <div class="card">
          <h3 data-i18n="p8.title">Cybersecurity Risk Management</h3>
          <p data-i18n="p8.desc">A risk assessment of storing unencrypted credit-card data and how to reduce the risks.</p>
          <a class="link" href="assets/Cybersecurity_Risk_Management_Report.pdf" target="_blank" data-i18n="projects.view">View file</a>
        </div>

      </div>
    </section>

    <!-- ===== Experience ===== -->
    <section id="experience">
      <h2 data-i18n="exp.title">Experience</h2>
      <div class="cards">
        <div class="card">
          <h3 data-i18n="exp.e1.role">Cisco Networking Instructor</h3>
          <p class="muted">ByTeq Academy | 06/2026 - <span data-i18n="exp.present">Present</span></p>
          <p data-i18n="exp.e1.desc">Deliver the Cisco NetAcad Networking Basics course through structured video lessons and explain technical concepts in a clear, practical way.</p>
        </div>
        <div class="card">
          <h3 data-i18n="exp.e2.role">Masar Cybersecurity Training</h3>
          <p class="muted">National Cybersecurity Center | 07/2025 - 09/2025</p>
          <p data-i18n="exp.e2.desc">200 hours of ethical hacking and CTF training: SIEM monitoring with Splunk, vulnerability assessment, penetration testing and security reporting.</p>
        </div>
        <div class="card">
          <h3 data-i18n="exp.e3.role">Public Relations Officer</h3>
          <p class="muted">IEEE Cybersecurity Society, TTU | 07/2023 - 07/2026</p>
          <p data-i18n="exp.e3.desc">Organized cybersecurity workshops, awareness events and technical sessions, and created digital content for the society.</p>
        </div>
        <div class="card">
          <h3 data-i18n="exp.e4.role">AI Content Creation</h3>
          <p class="muted">Noor Stories</p>
          <p data-i18n="exp.e4.desc">Created animated story videos using AI tools. Some videos reached over one million views.</p>
        </div>
      </div>
    </section>

    <!-- ===== Certificates ===== -->
    <section id="certificates">
      <h2 data-i18n="cert.title">Certificates</h2>
      <div class="about">
        <a class="cert-img" href="assets/certificate-masar.png" target="_blank">
          <img src="assets/certificate-masar.png" alt="Masar Cybersecurity Training certificate">
        </a>
        <div class="about-text">
          <h3 data-i18n="cert.name">Masar Cybersecurity Training</h3>
          <p data-i18n="cert.desc">Completed 200 hours of continuous training over 6 weeks in 2025, covering ethical hacking and CTF challenges, issued by the National Cybersecurity Center.</p>
        </div>
      </div>
    </section>

    <!-- ===== Hobbies ===== -->
    <section id="hobbies">
      <h2 data-i18n="hob.title">Hobbies</h2>
      <div class="cards">
        <div class="card">
          <h3 data-i18n="hob.h1">Capture The Flag</h3>
          <p data-i18n="hob.d1">Solving CTF challenges to sharpen my offensive and investigative thinking.</p>
        </div>
        <div class="card">
          <h3 data-i18n="hob.h2">Building Home Labs</h3>
          <p data-i18n="hob.d2">Running virtual machines to test tools and practice safely.</p>
        </div>
        <div class="card">
          <h3 data-i18n="hob.h3">Content Creation</h3>
          <p data-i18n="hob.d3">Creating animated stories and digital content with AI tools.</p>
        </div>
        <div class="card">
          <h3 data-i18n="hob.h4">Teaching &amp; Events</h3>
          <p data-i18n="hob.d4">Explaining networking and organizing workshops for my community.</p>
        </div>
      </div>
    </section>

    <!-- ===== Contact ===== -->
    <section id="contact">
      <h2 data-i18n="contact.title">Contact Me</h2>
      <div class="about">
        <div class="about-text">
          <p data-i18n="contact.sub">I am open to internships and junior roles in security operations and penetration testing.</p>
          <p><b data-i18n="contact.email">Email:</b> <a class="link" href="mailto:nooralshate@gmail.com">nooralshate@gmail.com</a></p>
          <p><b>LinkedIn:</b> <a class="link" href="https://www.linkedin.com/in/noor-alshater-443866316" target="_blank">noor-alshater</a></p>
          <p><b data-i18n="contact.phone">Phone:</b> <a class="link" href="tel:+962789868444" dir="ltr">+962 789 868 444</a></p>
        </div>

        <form id="contactForm">
          <label><span data-i18n="form.name">Name</span>
            <input type="text" id="fName" required>
          </label>
          <label><span data-i18n="form.email">Email</span>
            <input type="email" id="fEmail" required>
          </label>
          <label><span data-i18n="form.message">Message</span>
            <textarea id="fMsg" rows="5" required></textarea>
          </label>
          <button class="btn" type="submit" data-i18n="form.send">Send Message</button>
        </form>
      </div>
    </section>

  </main>

